# Plantilla de variables de entorno para OJOZ.
#
# Copia este archivo a ".env" (en esta misma carpeta) y rellena tus propias
# claves. El ".env" real NUNCA se sube a git (ya esta en .gitignore); esta
# plantilla si, para que cualquiera que clone el proyecto sepa que variables
# existen sin ver ninguna clave real.
#
# main.py y main_flet.py cargan este archivo solos al arrancar (con
# python-dotenv): despues de configurarlo aqui, ya no hace falta escribir
# nada en la terminal.

# --- Claves de API ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ANTHROPIC_API_KEY=
GOOGLE_VISION_API_KEY=

# --- Voz (ElevenLabs) ---
# eleven_v3_conversational: el mas expresivo en tiempo real, pensado para
# asistentes de voz. Alternativas: eleven_multilingual_v2 (menos expresivo),
# eleven_v3 (mas expresivo aun, pero mas lento) o eleven_flash_v2_5 (el mas
# rapido, suena apurado y se come las pausas).
ELEVENLABS_MODEL=eleven_v3_conversational

# --- Conversacion por modelo de lenguaje ---
# OJOZ_LLM=0 desactiva el modo conversacional y usa solo el enrutador por palabras clave.
OJOZ_LLM=1
# OJOZ_LLM_MODEL=claude-sonnet-5

# --- Camara ---
# Selecciona por nombre (mas confiable que un indice fijo). "iVCam" o "UVC WebCam"
# segun cual quieras usar; vacio para depender solo de OJOZ_CAMERA_INDEX.
# OJOZ_CAMERA_NAME=iVCam
# OJOZ_CAMERA_INDEX=0
# Gira el video (0/90/180/270) si la camara entrega horizontal en vertical.
# OJOZ_CAMERA_ROTATE=0
# Corrige el efecto espejo (comun con iVCam en modo selfie: el texto se ve al reves).
# OJOZ_CAMERA_FLIP=0

# --- Microfono ---
# OJOZ_MIC_INDEX=
# OJOZ_MIC_NAME=
# Empujar para hablar (mantener espacio). 0 vuelve a escucha continua.
# OJOZ_PUSH_TO_TALK=1

# --- Reconocimiento facial ---
# OJOZ_FACE_PROVIDER=auto
# OJOZ_FACE_MODEL=buffalo_l
# OJOZ_FACE_THRESHOLD=0.50

# --- Otros ajustes opcionales (los valores de arriba son los que usa el proyecto por defecto) ---
# OJOZ_SHOW_PREVIEW=1
# OJOZ_DENOISE=1
